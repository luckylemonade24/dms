{
  "name": "dungeon-duelist",
  "version": "0.0.9",
  "description": "地牢决斗师：踏上征途",
  "main": "main.js",
  "author": "下元咕",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.ddm.jn",
    "productName": "地牢决斗师",
    "electronLanguages": ["zh-CN", "en-US"],
    "artifactName": "DungeonDuelist-${version}-${ext}",
    "directories": { "output": "dist" },
    "files": [
      "**/*",
      "!**/*.log",
      "!**/.github/**",
      "!**/build-exe.ps1",
      "!dist/**"
    ],
    "win": {
      "target": ["nsis", "portable", "zip"],
      "icon": "app.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "地牢决斗师",
      "installerIcon": "app.ico",
      "uninstallerIcon": "app.ico",
      "artifactName": "DungeonDuelist-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "DungeonDuelist-${version}-Portable.${ext}"
    },
    "asar": true,
    "compression": "maximum"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "sharp": "latest"
  }
}